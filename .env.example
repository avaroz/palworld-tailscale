# ============================================
# PALWORLD SERVER CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# These variables are used to configure the Palworld server

# ==== BASIC SERVER SETTINGS ====
# Server name as it appears in the server list
PALWORLD_SERVER_NAME=Palworld Server

# Server password (leave empty for no password)
PALWORLD_SERVER_PASSWORD=

# Admin password for REST API server management (required by base image)
ADMIN_PASSWORD=

# Game port (default: 8211)
PALWORLD_PORT=8211

# Query port for server discovery (default: 27015)
PALWORLD_QUERY_PORT=27015

# ==== PLAYER & GAMEPLAY SETTINGS ====
# Maximum number of concurrent players
PALWORLD_MAX_PLAYERS=32

# Game difficulty level: Easy, Normal, Hard
PALWORLD_DIFFICULTY=Normal

# Game speed multiplier (1.0 = normal speed)
PALWORLD_GAME_SPEED=1.0

# ==== PVP SETTINGS ====
# Enable PvP combat between players
PALWORLD_IS_PVPABLE=false

# Enable player-to-player damage
PALWORLD_ENABLE_PLAYER_TO_PLAYER_DAMAGE=false

# Enable friendly fire
PALWORLD_ENABLE_FRIENDLY_FIRE=false

# ==== DEATH PENALTY ====
# Item, ItemAndEquipment, All, None
PALWORLD_DEATH_PENALTY=Item

# ==== AIM ASSIST ====
# Enable aim assist for controller players
PALWORLD_ENABLE_AIM_ASSIST_PAD=true

# Enable aim assist for keyboard players
PALWORLD_ENABLE_AIM_ASSIST_KEYBOARD=false

# ==== ITEM & RESOURCE LIMITS ====
# Maximum number of dropped items on the map
PALWORLD_DROP_ITEM_MAX_NUM=3000

# Maximum number of basic dropped items
PALWORLD_DROP_ITEM_MAX_NUM_UNKO_DEFAULT=100

# ==== BASE CAMP SETTINGS ====
# Maximum workers per base camp
PALWORLD_BASECAMPWORKER_MAXNUM=15

# ==== CLAN SETTINGS ====
# Maximum players per clan/guild
PALWORLD_CLAN_PLAYER_MAX_NUM=20

# ==== EXPERIENCE RATES ====
# Pal experience multiplier (1.0 = normal)
PALWORLD_PAL_EXP_RATE=1.0

# Player experience multiplier (1.0 = normal)
PALWORLD_PLAYER_EXP_RATE=1.0

# ==== PAL CAPTURE & SPAWN ====
# Pal capture rate multiplier (1.0 = normal, increase for easier catching)
PALWORLD_PAL_CAPTURE_RATE=1.0

# Pal spawn rate multiplier (1.0 = normal, increase for more Pals)
PALWORLD_PAL_SPAWN_NUM_RATE=1.0

# ==== DAMAGE SETTINGS ====
# Pal attack damage multiplier
PALWORLD_PAL_DAMAGE_RATE_ATTACK=1.0

# Pal defense multiplier
PALWORLD_PAL_DAMAGE_RATE_DEFENCE=1.0

# Player attack damage multiplier
PALWORLD_PLAYER_DAMAGE_RATE_ATTACK=1.0

# Player defense multiplier
PALWORLD_PLAYER_DAMAGE_RATE_DEFENCE=1.0

# ==== ADVANCED COMBAT ====
# Allow defense against other players' Pals
PALWORLD_ENABLE_DEFENSE_OTHER_PLAYER_PAL=false

# Pal work speed multiplier
PALWORLD_WORK_SPEED_PAL=1.0

# ==== TAILSCALE CONFIGURATION ====
# Tailscale VPN integration - see TAILSCALE_SETUP.md for detailed instructions
# Get your auth key from: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=

